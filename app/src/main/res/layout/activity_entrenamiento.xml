<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Indicador del ejercicio actual -->
    <TextView
        android:id="@+id/tvEjercicioActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Press Banca Inclinado"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:textAlignment="center"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp" />

    <!-- Fila HORIZONTAL para los inputs de datos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="32dp">

        <!-- Casilla de Peso -->
        <EditText
            android:id="@+id/etPeso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Kg"
            android:inputType="numberDecimal"
            android:textAlignment="center"
            android:textSize="20sp"/>

        <!-- Casilla de Repeticiones -->
        <EditText
            android:id="@+id/etReps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Reps"
            android:inputType="number"
            android:textAlignment="center"
            android:textSize="20sp"/>

        <!-- Casilla de RIR -->
        <EditText
            android:id="@+id/etRir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="RIR"
            android:inputType="number"
            android:textAlignment="center"
            android:textSize="20sp"/>
    </LinearLayout>

    <!-- Botón para guardar la serie e iniciar descanso (TD) -->
    <Button
        android:id="@+id/btnGuardarSerie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar Serie y Descansar"
        android:textSize="18sp"
        android:padding="16dp"
        android:backgroundTint="#4CAF50" /> <!-- Color verde para la acción principal -->

</LinearLayout>