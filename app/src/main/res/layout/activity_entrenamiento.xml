<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvEjercicioActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Press Banca Inclinado"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:textAlignment="center"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="32dp">

        <EditText
            android:id="@+id/etPeso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Kg"
            android:inputType="numberDecimal"
            android:textAlignment="center"
            android:textSize="20sp"/>

        <EditText
            android:id="@+id/etReps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Reps"
            android:inputType="number"
            android:textAlignment="center"
            android:textSize="20sp"/>

        <EditText
            android:id="@+id/etRir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="RIR"
            android:inputType="number"
            android:textAlignment="center"
            android:textSize="20sp"/>
    </LinearLayout>


    <TextView
        android:id="@+id/tvTemporizador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="02:00"
        android:textSize="56sp"
        android:textStyle="bold"
        android:textColor="#FF9800"
        android:textAlignment="center"
        android:layout_marginBottom="24dp"
        android:visibility="gone" />



    <Button
        android:id="@+id/btnGuardarSerie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar Serie y Descansar"
        android:textSize="18sp"
        android:padding="16dp"
        android:backgroundTint="#4CAF50" />

    <Button
        android:id="@+id/btnMasTiempo"
        android:text="+ 30s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

</LinearLayout>